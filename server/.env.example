# Server
PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/bmms
NODE_ENV=development

# CORS - comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Authentication (Phase 2) - required in production
JWT_SECRET=
